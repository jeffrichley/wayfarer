{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":dependencyDashboard"
  ],
  "timezone": "America/New_York",
  "labels": [
    "dependencies"
  ],
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "automerge": false
  },
  "platformAutomerge": false,
  "ignorePaths": [
    "prototype/**",
    "**/node_modules/**",
    "**/__fixtures__/**"
  ],
  "packageRules": [
    {
      "description": "Group all non-major updates into one PR and auto-merge once CI is green.",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin",
        "pinDigest",
        "lockFileMaintenance"
      ],
      "groupName": "non-major dependencies",
      "automerge": true
    },
    {
      "description": "Majors get their own PR and require human review (they can break at runtime even when CI is green).",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    },
    {
      "description": "Python itself moves only by a deliberate change to requires-python, CI and mypy together.",
      "matchDepNames": [
        "python"
      ],
      "enabled": false
    },
    {
      "description": "typescript-eslint does not accept TypeScript 7 yet; lift this when it does.",
      "matchPackageNames": [
        "typescript"
      ],
      "allowedVersions": "<7"
    }
  ]
}
